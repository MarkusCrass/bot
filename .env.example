# Telegram bot token from @BotFather
BOT_TOKEN=
# Channel numeric ID (for example -1001234567890) or @public_channel
CHANNEL_ID=
CHANNEL_URL=https://t.me/your_channel
ADMIN_ID=0
# Astrologer profile and Telegram ID for paid consultation notifications
ASTROLOGER_USERNAME=@your_astrologer
ASTROLOGER_ID=0
# Payments provider token from BotFather (Telegram Payments)
PROVIDER_TOKEN=
GUIDE_PRICE=499
CONSULT_PRICE=1500
LLM_API_KEY=
# OpenAI-compatible API root, e.g. https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
# Optional model name; defaults to gpt-4o-mini
LLM_MODEL=gpt-4o-mini
# Optional path to a Unicode TTF font (Arial or DejaVu Sans) if not found automatically
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
